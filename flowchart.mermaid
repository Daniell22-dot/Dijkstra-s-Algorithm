graph TD
    %% Configured for a balanced, compact grid (square footprint) with large bold text and heavy borders
    classDef process fill:#f8f9fa,stroke:#212529,stroke-width:3px,font-family:Arial,font-size:22px,color:#212529;
    classDef data fill:#e3f2fd,stroke:#0d47a1,stroke-width:3px,font-family:Arial,font-size:22px,color:#0d47a1;
    classDef db fill:#e8f5e9,stroke:#1b5e20,stroke-width:3px,font-family:Arial,font-size:22px,color:#1b5e20;
    classDef output fill:#fff3e0,stroke:#e65100,stroke-width:3px,font-family:Arial,font-size:22px,color:#e65100;
    
    subgraph ROW_1 ["STAGE 1: PREPROCESSING & EXPORT"]
        direction LR
        A1["ArchiCAD BIM Models"]:::data --> A2["Georeferencing & Alignment<br/>UTM Zone 37S / EPSG:32737"]:::process
        A2 --> A3["Export IFC4 Standard"]:::process
    end

    ROW_1 --> ROW_2

    subgraph ROW_2 ["PARALLEL PIPELINE TRANSFORMATION"]
        direction LR
        
        subgraph STREAM_A ["3D Visualization Stream"]
            direction TB
            B1["IfcConvert CLI<br/>glTF 2.0 Binary"]:::process --> B2["3D Tiler<br/>Cesium ion / pg2b3dm"]:::process
            B2 --> B3["Batched 3D Tiles<br/>b3dm & tileset.json"]:::data
        end

        subgraph STREAM_B ["Network Topology Stream"]
            direction TB
            C1["Centerline Extraction<br/>Corridors & Stairs"]:::process --> C2["3D Topology Generation<br/>POINTZ & LINESTRINGZ"]:::process
            C2 --> C3["PostGIS Database Load<br/>nodes & edges Tables"]:::db
        end
    end

    ROW_2 --> ROW_3

    subgraph ROW_3 ["ROUTING & WEB-GIS RENDERING"]
        direction LR
        D1["pgRouting Framework<br/>Dijkstra Shortest-Path"]:::process --> D2["CesiumJS Web Engine<br/>Load 3D Tiles Scene"]:::process
        D2 --> D3["Dynamic 3D Route Display<br/>PolylineGlow Rendering"]:::output
    end

    ROW_3 --> ROW_4

    subgraph ROW_4 ["PERFORMANCE EVALUATION"]
        direction LR
        E1["Efficiency<br/>Data Size %"]:::process --> E2["Latency<br/>Query ms"]:::process
        E2 --> E3["Frame Rate<br/>Rendering FPS"]:::process
    end