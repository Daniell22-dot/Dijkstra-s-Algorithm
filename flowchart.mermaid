graph TD
    classDef process fill:#f9f9f9,stroke:#333,stroke-width:2px,font-family:Arial,font-size:14px;
    classDef data fill:#e1f5fe,stroke:#01579b,stroke-width:2px,font-family:Arial,font-size:14px;
    classDef db fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,font-family:Arial,font-size:14px;
    classDef output fill:#fff3e0,stroke:#e65100,stroke-width:2px,font-family:Arial,font-size:14px;

    subgraph PHASE_1 [Data Acquisition & Preprocessing]
        A1[ArchiCAD BIM Source Models]:::data --> A2[Georeferencing & Spatial Alignment<br/>UTM Zone 37S / EPSG:32737]:::process
        A2 --> A3[Model Simplification & Filtering<br/>Removal of Non-Navigational Elements]:::process
        A3 --> A4[Space Definition & Zone Bounding<br/>IfcSpace Integration]:::process
    end

    subgraph PHASE_2 [Dual-Pipeline Interoperability Transformation]
        A4 --> B1[Export Dataset to ISO Standard<br/>Industry Foundation Classes - IFC4]:::process
        
        %% Stream 1: Visualization Pipeline
        B1 --> C1[3D Geometry Stream Extraction]:::process
        C1 --> C2[IfcConvert CLI Utility<br/>IFC to glTF 2.0 Binary]:::process
        C2 --> C3[Open-Source 3D Tiler<br/>Cesium ion / pg2b3dm]:::process
        C3 --> C4[Hierarchical Batched 3D Tiles<br/>.b3dm & tileset.json Structure]:::data

        %% Stream 2: Network Topology Pipeline
        B1 --> D1[Interior Network Stream Extraction]:::process
        D1 --> D2[Centerline Extraction & Door Intersection<br/>Corridors, Stairs, & Elevators]:::process
        D2 --> D3[3D Topology Generation<br/>POINTZ & LINESTRINGZ Network]:::process
        D3 --> D4[PostgreSQL / PostGIS Database Load<br/>indoor_nodes & indoor_edges Tables]:::db
    end

    subgraph PHASE_3 [Pathfinding Algorithmic Engine]
        D4 --> E1[pgRouting Framework Integration<br/>Graph Topology Construction]:::process
        E1 --> E2[Dijkstra Shortest-Path Computation<br/>Objective Cost Function: C = sum w e]:::process
        E2 --> E3[PL/pgSQL Path Query Execution<br/>pgr_dijkstra Function Optimization]:::process
    end

    subgraph PHASE_4 [Web-GIS Frontend Integration & Visualization]
        C4 --> F1[CesiumJS WebGL 3D Globe Engine<br/>Instantiation of 3D Tileset]:::process
        E3 --> F2[Asynchronous REST API Integration<br/>JSON Path Coordinate Fetching]:::process
        F1 --> F3[Dynamic 3D Route Rendering<br/>Cesium.PolylineGlow Over Multi-Floors]:::output
        F2 --> F3
    end

    subgraph PHASE_5 [Evaluation & Performance Validation]
        F3 --> G1[Metric 1: Interoperability Efficiency<br/>Data Size Reduction & Mesh Loss %]:::process
        F3 --> G2[Metric 2: Query Latency<br/>pgr_dijkstra Execution Time in ms]:::process
        F3 --> G3[Metric 3: Browser Frame Rate<br/>Client-Side Rendering Performance in FPS]:::process
    end